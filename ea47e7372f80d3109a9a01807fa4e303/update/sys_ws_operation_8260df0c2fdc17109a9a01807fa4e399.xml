        <name>fetchMyLeaves</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
    var result = [];
    var userId = gs.getUserID();
	var gr = new GlideRecord('x_1929781_enterp_0_leave_management_system');
	gr.addQuery('employee', userId);
	gr.query();
	while(gr.next()) {
		result.push({
			employee: gr.getValue('employee'),
			leave_type: gr.getValue('leave_type'),
			status: gr.getValue('status'),
			start_date: gr.getValue('start_date'),
			end_date: gr.getValue('end_date')
		});
	}
	response.setBody(result);
})(request, response);]]></operation_script>
